<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keeps the code AOT-clean from day one, so phase 2 (PublishAot) is a
         build-property flip rather than a rewrite. See PLAN.md. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <Version>3.0.0</Version>
    <Product>Timestamp Copy</Product>
    <Company>jurakovic</Company>
    <Copyright>Copyright (c) jurakovic</Copyright>
    <RepositoryUrl>https://github.com/jurakovic/timestamp-copy</RepositoryUrl>
  </PropertyGroup>

</Project>
